      "sceneId": "c2-call",
      "speaker": "谢听禾",
      "text": "先说一下，我的网可能卡。卡住的时候不用急着挂。",
      "medium": "call",
      "noSprite": true,
      "textSha256": "34dd051bdaaa3c5606ee46cf90f08a01624b068414b02947bb4a81ee3697cfa6",
